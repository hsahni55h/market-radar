# Runtime environment name.
APP_ENV=dev
# Python logging level.
LOG_LEVEL=INFO
# IANA timezone used by the application.
TIMEZONE=Asia/Kolkata
# Path to the Nifty 500 constituents CSV.
UNIVERSE_CSV_PATH=data/reference/nifty500.csv
# Path to the NSE trading-holiday CSV for the current year.
HOLIDAYS_CSV_PATH=data/reference/nse_holidays_2026.csv
# Minimum share of the universe that must return quotes before sending a movers list.
MIN_SUCCESS_RATIO=0.95
# Discord webhook URL; leave blank until alerts are configured.
DISCORD_WEBHOOK_URL=
